{
  "name": "@capgo/vite-capacitor",
  "version": "0.1.0",
  "description": "Vite plugin that keeps native Capacitor platform configs in sync with the dev server URL.",
  "main": "dist/index.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "files": [
    "dist/"
  ],
  "author": "Martin Donadieu <martin@capgo.app>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cap-go/vite-capacitor.git"
  },
  "bugs": {
    "url": "https://github.com/Cap-go/vite-capacitor/issues"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "vite",
    "dev server",
    "automation"
  ],
  "scripts": {
    "verify": "npm run lint && npm run build",
    "lint": "npm run eslint && npm run prettier -- --check",
    "fmt": "npm run eslint -- --fix && npm run prettier -- --write",
    "eslint": "eslint . --ext .ts",
    "prettier": "prettier \"**/*.{ts,js,json}\"",
    "build": "npm run clean && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "eslint": "^9.11.1",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "rollup": "^4.34.6",
    "typescript": "^5.7.3",
    "vite": "^5.2.0"
  },
  "peerDependencies": {
    "vite": ">=4.0.0"
  },
  "type": "module"
}
